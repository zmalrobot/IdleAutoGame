<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IdleAutoGame.Core\IdleAutoGame.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CopyVulkanCpuDependency" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)runtimes\linux-x64\native\avx2\libggml-cpu.so"
          DestinationFolder="$(TargetDir)runtimes\linux-x64\native\vulkan\"
          Condition="Exists('$(TargetDir)runtimes\linux-x64\native\avx2\libggml-cpu.so') And Exists('$(TargetDir)runtimes\linux-x64\native\vulkan\') And !Exists('$(TargetDir)runtimes\linux-x64\native\vulkan\libggml-cpu.so')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
