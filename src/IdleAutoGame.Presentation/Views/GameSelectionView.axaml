<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.GameSelectionView"
             x:DataType="vm:GameSelectionViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Moduli di Gioco Supportati" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Seleziona e configura i giochi idle supportati con relative policy di sicurezza e vincoli." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Active Game Authoritative Banner -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource PrimaryMainBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryMainBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="🎮 GIOCO ATTIVO" FontWeight="Bold" FontSize="11" Foreground="#091015"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ActiveGameName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ActiveGamePackage, StringFormat='(Package: {0})'}" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding ActiveGameDetectionStatus, StringFormat='Rilevamento: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnDefinitions="360,*" Margin="0,0,0,16">
            <!-- Left: Games List -->
            <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Giochi Disponibili" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                             Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameDisplayItem">
                                <Border Padding="12" Margin="0,0,0,4" Background="{DynamicResource Surface1Brush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsActive}">
                                                    <TextBlock Text="✓ GIOCO ATTIVO" FontSize="10" FontWeight="Bold" Foreground="#091015"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExpectedPackageName, StringFormat='Package: {0}'}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"/>
                                            <TextBlock Text="{Binding Version, StringFormat='Versione: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Attiva"
                                                Command="{Binding $parent[UserControl].((vm:GameSelectionViewModel)DataContext).SetActiveGameItemCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsActive}"
                                                Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" FontSize="11" Padding="10,3" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Game Details -->
            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding SelectedGame.Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedGame.Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <!-- Security & Spending Policies (Deny By Default) Prominent Card -->
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <TextBlock Text="Politiche di Sicurezza &amp; Spesa (Deny-by-Default):" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Policy Attiva" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                </DockPanel>

                                <CheckBox IsChecked="{Binding AllowPremiumCurrency}" Content="Permetti all'LLM di usare currency premium"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="Quando disabilitato (OFF), l'LLM non può spendere diamanti, gemme o valute a pagamento."
                                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="28,-6,0,0"/>

                                <CheckBox IsChecked="{Binding AllowCreditPurchases}" Content="Permetti all'LLM di acquistare crediti"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="Quando disabilitato (OFF), l'LLM non può avviare acquisti in-app con denaro reale e l'Activity Guard monitora il foreground."
                                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="28,-6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Safety Constraints:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding SelectedGame.Game.Constraints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,8,0" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Gameplay Instructions &amp; Prompt Summary:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="120">
                            <ScrollViewer>
                                <TextBlock Text="{Binding SelectedGame.Game.BasePrompt}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right" Content="Imposta come Gioco Attivo" Command="{Binding SaveSelectionCommand}"
                    Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="16,10"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
