<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.GameSelectionView"
             x:DataType="vm:GameSelectionViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Game Modules" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Select and configure supported idle games." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="350,*" Margin="0,0,0,16">
            <!-- Left: Games List -->
            <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                         Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDarkBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right: Game Details -->
            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding SelectedGame.Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedGame.Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <!-- Security & Spending Policies (Deny By Default) Prominent Card -->
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <TextBlock Text="Security &amp; Spending Policies (Deny-by-Default):" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Policy Enforced" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                </DockPanel>

                                <CheckBox IsChecked="{Binding AllowPremiumCurrency}" Content="Permetti all'LLM di usare currency premium"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="Quando disabilitato (OFF), l'LLM non può spendere diamanti, gemme o valute a pagamento."
                                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="28,-6,0,0"/>

                                <CheckBox IsChecked="{Binding AllowCreditPurchases}" Content="Permetti all'LLM di acquistare crediti"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="Quando disabilitato (OFF), l'LLM non può avviare acquisti in-app con denaro reale e l'Activity Guard monitora il foreground."
                                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="28,-6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Safety Constraints:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding SelectedGame.Constraints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,8,0" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Gameplay Instructions &amp; Prompt Summary:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="120">
                            <ScrollViewer>
                                <TextBlock Text="{Binding SelectedGame.BasePrompt}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Select as Active Game" Command="{Binding SaveSelectionCommand}"
                    Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="16,10"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
