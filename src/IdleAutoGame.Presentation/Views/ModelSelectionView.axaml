<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.ModelSelectionView"
             x:DataType="vm:ModelSelectionViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Modelli AI e Visione" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Scegli tra modelli locali ad alta privacy GGUF (LLamaSharp/llama.cpp) ed endpoint remoti." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Active Model Authoritative Banner -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource PrimaryMainBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryMainBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="🧠 MODELLO ATTIVO" FontWeight="Bold" FontSize="11" Foreground="#091015"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ActiveModelDisplayName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ActiveModelId, StringFormat='(ID: {0})'}" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding ActiveModelProvider, StringFormat='Provider: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryLightBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding ActiveModelStatus, StringFormat='Stato: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode Toggle Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Rileva Hardware" Command="{Binding LoadModelsCommand}"
                        Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="12,6"/>
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <TextBlock Text="Modalità Inferenza:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <RadioButton Content="LLM Locale (llama.cpp / LLamaSharp)" IsChecked="{Binding IsLocalMode}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton Content="LLM Remoto (Cloud / OpenAI API)" IsChecked="{Binding !IsLocalMode}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <!-- LOCAL LLM PANEL -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsLocalMode}">
                <!-- RAM Tier Banner -->
                <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{Binding DetectedRamTierText}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding DetectedRamText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Modelli Consigliati per il tuo profilo RAM" FontSize="12" Foreground="{DynamicResource SecondaryLightBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Recommended Models List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding RecommendedLocalModels}" SelectedItem="{Binding SelectedLocalModel}"
                         Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalModelDisplayItem">
                            <Border Padding="14" Margin="0,0,0,8" Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <!-- Header: Name, Architecture, Quantization, RAM Requirement -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Model.DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <!-- ACTIVE BADGE -->
                                            <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsActive}">
                                                <TextBlock Text="✓ MODELLO ATTIVO" FontSize="10" FontWeight="Bold" Foreground="#091015"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Model.Architecture}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Model.Quantization}" FontSize="11" Foreground="{DynamicResource SecondaryLightBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding MmprojBadge}" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding RamBadge}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource PrimaryDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                    ToolTip.Tip="{Binding GpuRecommendationText}">
                                                <TextBlock Text="{Binding GpuCompatibilityBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLightBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Model.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Right: Badges and Actions -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CompatibilityReason}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>

                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="Scarica Modello"
                                                    Command="{Binding $parent[UserControl].((vm:ModelSelectionViewModel)DataContext).DownloadModelCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding !IsInstalled}"
                                                    IsEnabled="{Binding IsCompatible}"
                                                    Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="10,4" FontSize="12"/>

                                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsInstalled}">
                                                <TextBlock Text="Installato" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>

                                            <Button Content="Attiva Modello"
                                                    Command="{Binding $parent[UserControl].((vm:ModelSelectionViewModel)DataContext).SetActiveLocalModelItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanActivate}"
                                                    IsEnabled="{Binding !$parent[UserControl].((vm:ModelSelectionViewModel)DataContext).IsModelLoadedInMemory}"
                                                    Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="10,4" FontSize="12"/>

                                            <Button Content="Scarica dalla RAM"
                                                    Command="{Binding $parent[UserControl].((vm:ModelSelectionViewModel)DataContext).UnloadActiveModelCommand}"
                                                    IsVisible="{Binding CanUnload}"
                                                    Background="{DynamicResource ErrorBrush}" Foreground="#091015" FontWeight="Bold" Padding="10,4" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Download Progress Area -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding IsDownloading}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DownloadProgressText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" Margin="12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadEtaText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <ProgressBar Grid.Column="0" Value="{Binding DownloadPercentage}" Maximum="100" Height="8"
                                                         Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource PrimaryMainBrush}" CornerRadius="4"/>
                                            <Button Grid.Column="1" Content="Annulla"
                                                    Command="{Binding $parent[UserControl].((vm:ModelSelectionViewModel)DataContext).CancelDownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource ErrorBrush}" Foreground="#091015" FontWeight="Bold" FontSize="11" Padding="8,2" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- REMOTE LLM PANEL -->
            <Grid ColumnDefinitions="*,360" IsVisible="{Binding !IsLocalMode}">
                <!-- Left: Profiles -->
                <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Provider Cloud Remoti" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableRemoteModels}" SelectedItem="{Binding SelectedRemoteItem}"
                                 Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RemoteModelDisplayItem">
                                    <Border Padding="12" Margin="0,0,0,4" Background="{DynamicResource Surface1Brush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Profile.Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsActive}">
                                                        <TextBlock Text="✓ ATTIVO" FontSize="10" FontWeight="Bold" Foreground="#091015"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Profile.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Attiva"
                                                    Command="{Binding $parent[UserControl].((vm:ModelSelectionViewModel)DataContext).SetActiveRemoteModelItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding !IsActive}"
                                                    Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" FontSize="11" Padding="10,3" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right: Endpoint and API Key -->
                <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Configurazione Endpoint" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="URL Endpoint:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding Endpoint}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderLightBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="API Key (Opzionale):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding ApiKey}" PasswordChar="*" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderLightBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Content="Salva e Attiva Modello" Command="{Binding SaveSelectionCommand}"
                    Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="16,10"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
