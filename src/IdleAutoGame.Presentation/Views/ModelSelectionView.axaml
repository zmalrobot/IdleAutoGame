<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.ModelSelectionView"
             x:DataType="vm:ModelSelectionViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" Background="#1E1E2E">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="AI / Vision Models" FontSize="24" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="Select local llama.cpp GGUF vision models or configure OpenAI-compatible endpoints." Foreground="#A6ADC8"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,360" Margin="0,0,0,16">
            <!-- Left: Model Profiles -->
            <Border Grid.Column="0" Background="#2A2A3C" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Check Compatibility" Command="{Binding LoadModelsCommand}"
                                Background="#313244" Foreground="#CDD6F4" Padding="12,6"/>
                        <TextBlock Text="Available Model Profiles" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedItem}"
                             Background="#181825" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" BorderThickness="0,0,0,1" BorderBrush="#313244">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Profile.Name}" FontWeight="Bold" Foreground="#CDD6F4"/>
                                                <Border Background="#313244" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Profile.QualityTier}" FontSize="10" Foreground="#89B4FA"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Profile.Description}" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CompatibilityReason}" FontSize="11" Foreground="#A6E3A1" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#313244" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Profile.Provider}" FontSize="11" Foreground="#CBA6F7"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Endpoint Configuration -->
            <Border Grid.Column="1" Background="#2A2A3C" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Inference API Configuration" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Endpoint URL:" FontSize="12" Foreground="#A6ADC8"/>
                        <TextBox Text="{Binding Endpoint}" Background="#181825" Foreground="#CDD6F4"/>
                        <TextBlock Text="e.g. http://localhost:8080 or https://api.openai.com" FontSize="11" Foreground="#6C7086"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="API Key (Optional / Remote):" FontSize="12" Foreground="#A6ADC8"/>
                        <TextBox Text="{Binding ApiKey}" PasswordChar="*" Background="#181825" Foreground="#CDD6F4"/>
                    </StackPanel>

                    <Separator Background="#45475A"/>

                    <TextBlock Text="Hardware Requirements:" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                    <TextBlock Text="• Minimum 8 GB RAM recommended for local 7B models." FontSize="12" Foreground="#A6ADC8"/>
                    <TextBlock Text="• Cloud models require network access but 0 local RAM." FontSize="12" Foreground="#A6ADC8"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Save and Activate Model" Command="{Binding SaveSelectionCommand}"
                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="16,10"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#F9E2AF"/>
        </DockPanel>
    </Grid>
</UserControl>
