<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Application Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Manage global configuration, inference timeouts, automation policies, and logging." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <TabControl Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="MinHeight" Value="34"/>
                    </Style>
                </TabControl.Styles>

                <!-- Tab 1: Generale -->
                <TabItem Header="Generale">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Locale / Lingua dell'interfaccia:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableLocales}"
                                          SelectedItem="{Binding Locale}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource Surface2Brush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Politica di errore ('pause', 'stop', 'ignore'):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableErrorPolicies}"
                                          SelectedItem="{Binding ErrorPolicy}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource Surface2Brush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AutoReconnect}" Content="Riconnessione automatica in caso di disconnessione device" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: LLM / Modelli locali -->
                <TabItem Header="LLM / Modelli locali">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16">
                            <!-- Cloud & Remote Provider -->
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Configurazione Provider LLM (Cloud / OpenAI / Local)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="Provider (LLamaSharp, openai, llama.cpp):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding AvailableLlmProviders}"
                                                      SelectedItem="{Binding LlmProvider}"
                                                      HorizontalAlignment="Stretch"
                                                      Background="{DynamicResource Surface1Brush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="Endpoint URL:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding LlmEndpoint}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="API Key (Opzionale):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding LlmApiKey}" PasswordChar="*" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="Temperature (0.0 - 2.0):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding LlmTemperature}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Max Token Generazione:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding LlmMaxTokens}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                                            <TextBlock Text="Timeout Inferenza (Secondi):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding LlmTimeoutSeconds}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Accelerazione GPU & Vulkan -->
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Rileva GPU"
                                                Command="{Binding RefreshGpuDevicesCommand}"
                                                IsEnabled="{Binding !IsExecutionLocked}"
                                                Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="10,4" FontSize="12"/>
                                        <TextBlock Text="Accelerazione GPU Vulkan" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Status / Profile Banner -->
                                    <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding DetectedGpuSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding ActiveVramProfile, StringFormat='Profilo VRAM: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding IsVulkanAvailable}">
                                                <TextBlock Text="VULKAN DISPONIBILE" FontSize="9" FontWeight="Bold" Foreground="#091015"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                        <!-- Usa GPU & Dispositivo -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,8,8">
                                            <CheckBox IsChecked="{Binding UseGpu}" Content="Usa GPU (Accelerazione Vulkan)"
                                                      IsEnabled="{Binding !IsExecutionLocked}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="Dispositivo GPU:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding AvailableGpuDevices}"
                                                      SelectedItem="{Binding SelectedGpuDevice}"
                                                      IsEnabled="{Binding !IsExecutionLocked}"
                                                      HorizontalAlignment="Stretch"
                                                      Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Modalita Offload -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6" Margin="0,0,0,8">
                                            <TextBlock Text="Modalità Offload GPU:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            <ComboBox ItemsSource="{Binding AvailableOffloadModes}"
                                                      SelectedItem="{Binding GpuOffloadMode}"
                                                      IsEnabled="{Binding !IsExecutionLocked}"
                                                      HorizontalAlignment="Stretch"
                                                      Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                            <TextBlock Text="Auto calcola dinamicamente i layer ottimali in base a modello e VRAM." FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                                        </StackPanel>

                                        <!-- VRAM Riservata & Minima Libera -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="VRAM Riservata SO / Display (MB):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding GpuMemoryReserveMb}" IsEnabled="{Binding !IsExecutionLocked}"
                                                     Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                                            <TextBlock Text="VRAM Minima Libera Richiesta (MB):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding GpuMinFreeMemoryMb}" IsEnabled="{Binding !IsExecutionLocked}"
                                                     Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fallback Options -->
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <CheckBox IsChecked="{Binding AllowGpuFallback}" Content="Consenti Fallback"
                                                  IsEnabled="{Binding !IsExecutionLocked}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                        <CheckBox IsChecked="{Binding FallbackToCpu}" Content="Fallback su CPU se GPU fallisce"
                                                  IsEnabled="{Binding !IsExecutionLocked}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                        <CheckBox IsChecked="{Binding FallbackToGpu}" Content="Usa GPU anche in fallback runtime"
                                                  IsEnabled="{Binding !IsExecutionLocked}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Hardware Auto-Config & Storage -->
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Auto-Configura per il mio Hardware"
                                                Command="{Binding AutoConfigureLlmCommand}"
                                                Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="12,6"/>
                                        <TextBlock Text="Accelerazione Hardware &amp; Parametri llama.cpp" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Cartella Modelli GGUF:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding ModelStorageDirectory}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="Context Window (tokens):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding ContextSize}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="Thread CPU:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding ThreadCount}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="Layer GPU in VRAM:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding GpuLayerCount}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="Batch Size:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding BatchSize}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Top-P:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding TopP}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Top-K:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding TopK}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Seed (0 = Casuale):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding Seed}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding UseMemoryMapping}" Content="Usa mmap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding UseMemoryLock}" Content="Usa mlock" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="Scarica Modello Attivo dalla RAM"
                                                Command="{Binding UnloadActiveModelCommand}"
                                                IsEnabled="{Binding IsModelLoadedInMemory}"
                                                Background="{DynamicResource ErrorBrush}" Foreground="#091015" FontWeight="Bold" Padding="10,4" FontSize="12"/>
                                        <TextBlock Text="Libera tutta la memoria RAM/VRAM allocata." Foreground="{DynamicResource TextDisabledBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Model Catalog & Disk Management -->
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Aggiorna Lista Modelli"
                                                Command="{Binding RefreshLocalModelsCommand}"
                                                Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="10,4" FontSize="12"/>
                                        <TextBlock Text="Catalogo Modelli GGUF &amp; Gestione Disco" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding LocalModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Architecture}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                                </Border>
                                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Quantization}" FontSize="10" Foreground="{DynamicResource SecondaryLightBrush}"/>
                                                                </Border>
                                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource WarningBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                                <TextBlock Text="{Binding RecommendedRamRange, StringFormat='RAM: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding LicenseName, StringFormat='Licenza: {0}'}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Content="Scarica"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DownloadModelCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Attiva"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectActiveModelCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding !$parent[UserControl].((vm:SettingsViewModel)DataContext).IsModelLoadedInMemory}"
                                                                    Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Elimina"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteModelCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{DynamicResource ErrorBrush}" Foreground="#091015" FontSize="11" Padding="8,4"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Generic System Prompt Configuration -->
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Ripristina Prompt Predefinito"
                                                Command="{Binding ResetGenericSystemPromptCommand}"
                                                Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="10,4" FontSize="11"/>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Prompt di Sistema Generico (Comune a tutti i giochi)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Istruisce il modello sul suo ruolo di agente autonomo, formato JSON di risposta, mosse e dati disponibili." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBox Text="{Binding GenericSystemPrompt}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas, monospace"
                                             FontSize="11"
                                             MinHeight="220"
                                             MaxHeight="380"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource Surface1Brush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderLightBrush}"/>

                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{Binding GenericPromptCharCount, StringFormat='Caratteri: {0:N0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding EstimatedTokenCount, StringFormat='Token stimati: ~{0:N0}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="💡 Questo prompt viene combinato dinamicamente con le regole specifiche del gioco attivo." FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: Dispositivo / ADB -->
                <TabItem Header="Dispositivo / ADB">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Preferenza di Connessione ('usb' o 'wireless'):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableConnectionPreferences}"
                                          SelectedItem="{Binding ConnectionPreference}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource Surface2Brush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Seriale Dispositivo Predefinito (Opzionale):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DefaultDeviceSerial}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Timeout Comandi ADB (Secondi):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdbCommandTimeoutSeconds}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 4: Giochi e Policy -->
                <TabItem Header="Giochi e Policy">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Intervallo di Osservazione Screenshot (Secondi):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding ObservationIntervalSeconds}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Stati Sconosciuti Consecutivi Massimi prima della Pausa:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding MaxConsecutiveUnknownStates}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource BorderDarkBrush}"/>
                            <TextBlock Text="Android Activity Guard (Sicurezza Anti-Escursione Fuori dal Gioco):" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLightBrush}"/>
                            <CheckBox IsChecked="{Binding EnableActivityGuard}" Content="Abilita Android Activity Guard (Monitoraggio Foreground)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Intervallo Polling Activity (Secondi):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding ActivityCheckIntervalSeconds}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Timeout Grazioso di Cancellazione (ms):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding ActivityCancellationTimeoutMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Timeout Emergency Hard Stop (ms):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding EmergencyStopTimeoutMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource BorderDarkBrush}"/>
                            <TextBlock Text="⏱️ Timing Azioni — Gesture e Input:" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Intervallo Double Tap (ms, default 120):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DoubleTapIntervalMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Durata Long Press predefinita (ms, default 1000):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DefaultLongPressDurationMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Durata Swipe predefinita (ms, default 300):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DefaultSwipeDurationMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Durata Drag predefinita (ms, default 1000):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DefaultDragDurationMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Durata Scroll predefinita (ms, default 400):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DefaultScrollDurationMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Distanza Scroll predefinita (0.05–0.90, default 0.4):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding DefaultScrollDistance}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Lunghezza Max Testo Input (default 100 car.):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding MaxTextInputLength}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Lunghezza Max Sequenza Tasti (default 10):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding MaxKeySequenceLength}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Timeout Esecuzione Azione (s, default 15):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding ActionExecutionTimeoutSeconds}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource BorderDarkBrush}"/>
                            <TextBlock Text="Policy Predefinite Valuta e Acquisti (Deny-by-Default):" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            <CheckBox IsChecked="{Binding AllowPremiumCurrencyDefault}" Content="Permetti all'LLM di usare currency premium (Predefinito: Disabilitato)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox IsChecked="{Binding AllowCreditPurchasesDefault}" Content="Permetti all'LLM di acquistare crediti (Predefinito: Disabilitato)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 5: Logging e Audit -->
                <TabItem Header="Logging e Audit">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Livello di Log ('Debug', 'Information', 'Warning', 'Error'):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableLogLevels}"
                                          SelectedItem="{Binding LogLevel}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource Surface2Brush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Giorni di Conservazione Cronologia (Retention Days):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding RetentionDays}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Numero Cicli Mantenuti in Memoria (History Length):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding HistoryLength}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding SaveScreenshots}" Content="Archivia file PNG degli screenshot su disco per audit/replay" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox IsChecked="{Binding SaveRawLlmOutput}" Content="Registra stream e raw output completo LLM nei log diagnostici" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 6: Interfaccia / Aspetto -->
                <TabItem Header="Interfaccia / Aspetto">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Tema UI ('dark', 'light'):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding Theme}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource Surface2Brush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ShowConfidence}" Content="Mostra Badge di Confidenza nella Dashboard" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox IsChecked="{Binding ShowRawResponse}" Content="Mostra JSON Risposta Grezza nel Pannello Ispettore" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Dimensione Massima Buffer Raw Output Streaming (caratteri):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding MaxVisibleRawOutputCharacters}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Intervallo Flush UI Streaming (ms, min 10):" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding StreamingUiUpdateIntervalMs}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderLightBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                <Button Content="Reset to Defaults" Command="{Binding ResetDefaultsCommand}"
                        Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource ErrorBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,10"/>
                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                        Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="20,10"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
