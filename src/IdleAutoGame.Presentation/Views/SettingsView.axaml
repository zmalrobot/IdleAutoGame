<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" Background="#1E1E2E">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Application Settings" FontSize="24" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="Manage global configuration, inference timeouts, automation policies, and logging." Foreground="#A6ADC8"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#2A2A3C" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <TabControl Background="Transparent">
                <!-- Tab 1: LLM -->
                <TabItem Header="LLM &amp; Vision">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Provider:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmProvider}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Inference Endpoint URL:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmEndpoint}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="API Key (Optional):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmApiKey}" PasswordChar="*" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Temperature (0.0 - 2.0):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmTemperature}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Max Generation Tokens:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmMaxTokens}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Timeout Seconds:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmTimeoutSeconds}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Max Inference Retries:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LlmMaxRetries}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Local LLM & Models -->
                <TabItem Header="Local Models &amp; llama.cpp">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16">
                            <!-- Hardware Auto-Config & Storage -->
                            <Border Background="#181825" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Auto-Configure for My Hardware"
                                                Command="{Binding AutoConfigureLlmCommand}"
                                                Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="12,6"/>
                                        <TextBlock Text="Hardware Acceleration &amp; Runtime Settings" FontSize="15" FontWeight="SemiBold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Model Storage Directory:" Foreground="#A6ADC8"/>
                                        <TextBox Text="{Binding ModelStorageDirectory}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="Context Size (tokens):" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding ContextSize}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="CPU Threads:" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding ThreadCount}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,8,8">
                                            <TextBlock Text="GPU Layers to Offload:" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding GpuLayerCount}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="Batch Size:" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding BatchSize}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Top-P:" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding TopP}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Top-K:" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding TopK}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Seed (0 = Random):" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBox Text="{Binding Seed}" Background="#2A2A3C" Foreground="#CDD6F4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding UseMemoryMapping}" Content="Use mmap" Foreground="#CDD6F4" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding UseMemoryLock}" Content="Use mlock" Foreground="#CDD6F4" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="Unload Active Model from RAM"
                                                Command="{Binding UnloadActiveModelCommand}"
                                                Background="#F38BA8" Foreground="#11111B" Padding="10,4" FontSize="12"/>
                                        <TextBlock Text="Free all allocated weights and memory contexts." Foreground="#6C7086" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Model Catalog & Disk Management -->
                            <Border Background="#181825" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Refresh Models"
                                                Command="{Binding RefreshLocalModelsCommand}"
                                                Background="#313244" Foreground="#CDD6F4" Padding="10,4" FontSize="12"/>
                                        <TextBlock Text="Catalog GGUF Models &amp; Local Storage" FontSize="15" FontWeight="SemiBold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding LocalModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A3C" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#CDD6F4"/>
                                                                <Border Background="#313244" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Architecture}" FontSize="10" Foreground="#89B4FA"/>
                                                                </Border>
                                                                <Border Background="#313244" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Quantization}" FontSize="10" Foreground="#CBA6F7"/>
                                                                </Border>
                                                                <Border Background="#313244" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#F9E2AF"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                                <TextBlock Text="{Binding RecommendedRamRange, StringFormat='RAM: {0}'}" FontSize="11" Foreground="#A6ADC8"/>
                                                                <TextBlock Text="{Binding LicenseName, StringFormat='License: {0}'}" FontSize="11" Foreground="#6C7086"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Content="Download"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DownloadModelCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#89B4FA" Foreground="#11111B" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Activate"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectActiveModelCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#A6E3A1" Foreground="#11111B" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Delete"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteModelCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#F38BA8" Foreground="#11111B" FontSize="11" Padding="8,4"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: Automation -->
                <TabItem Header="Automation">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Observation Interval (Seconds):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding ObservationIntervalSeconds}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Error Policy ('pause', 'stop', 'ignore'):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding ErrorPolicy}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Max Consecutive Unknown States Before Pause:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding MaxConsecutiveUnknownStates}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AutoReconnect}" Content="Automatically Reconnect Dropped Devices" Foreground="#CDD6F4"/>

                            <Separator Background="#313244"/>
                            <TextBlock Text="Android Activity Guard &amp; Safety Boundary:" FontWeight="SemiBold" Foreground="#89B4FA"/>
                            <CheckBox IsChecked="{Binding EnableActivityGuard}" Content="Enable Android Activity Guard (Foreground App Monitoring)" Foreground="#CDD6F4"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Activity Polling Interval (Seconds):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding ActivityCheckIntervalSeconds}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Cancellation Grace Period Timeout (ms):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding ActivityCancellationTimeoutMs}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Emergency Hard Stop Timeout (ms):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding EmergencyStopTimeoutMs}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: General & UI -->
                <TabItem Header="General &amp; UI">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Theme ('dark', 'light'):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding Theme}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Device Connection Preference ('usb', 'wireless'):" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding ConnectionPreference}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ShowConfidence}" Content="Show Confidence Badges on Dashboard" Foreground="#CDD6F4"/>
                            <CheckBox IsChecked="{Binding ShowRawResponse}" Content="Show Raw Model JSON in Inspector" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 4: Logging & Persistence -->
                <TabItem Header="Logging &amp; Storage">
                    <ScrollViewer Margin="0,16,0,0">
                        <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Log Level:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding LogLevel}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="History Retention Days:" Foreground="#A6ADC8"/>
                                <TextBox Text="{Binding RetentionDays}" Background="#181825" Foreground="#CDD6F4"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding SaveScreenshots}" Content="Archive Screenshot PNGs on Disk" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                <Button Content="Reset to Defaults" Command="{Binding ResetDefaultsCommand}"
                        Background="#313244" Foreground="#F38BA8" Padding="14,10"/>
                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                        Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="20,10"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#F9E2AF"/>
        </DockPanel>
    </Grid>
</UserControl>

