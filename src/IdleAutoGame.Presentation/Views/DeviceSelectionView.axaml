<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.DeviceSelectionView"
             x:DataType="vm:DeviceSelectionViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Gestione Dispositivi Android" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Rileva, connetti e imposta il dispositivo Android target su cui eseguire l'automazione." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Active Device Autoritative Banner -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource PrimaryMainBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryMainBrush}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="📱 DISPOSITIVO ATTIVO" FontWeight="Bold" FontSize="11" Foreground="#091015"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ActiveDeviceName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ActiveSerial, StringFormat='(Seriale: {0})'}" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding ActiveConnectionType, StringFormat='Connessione: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryLightBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding ActiveDeviceStatus, StringFormat='Stato: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Split -->
        <Grid Grid.Row="2" ColumnDefinitions="*,340" Margin="0,0,0,16">
            <!-- Left: Device List -->
            <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Aggiorna Dispositivi" Command="{Binding RefreshDevicesCommand}"
                                Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="12,6"/>
                        <TextBlock Text="Dispositivi Rilevati (USB e Wireless)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceDisplayItem">
                                <Border Padding="12" Margin="0,0,0,4" Background="{DynamicResource Surface1Brush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <!-- ACTIVE BADGE -->
                                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsActive}">
                                                    <TextBlock Text="✓ ATTIVO" FontSize="10" FontWeight="Bold" Foreground="#091015"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Serial, StringFormat='Seriale: {0}'}" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"/>
                                            <TextBlock Text="{Binding ScreenResolution, StringFormat='Risoluzione: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="{DynamicResource PrimaryLightBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <Button Content="Imposta come Attivo"
                                                    Command="{Binding $parent[UserControl].((vm:DeviceSelectionViewModel)DataContext).SetActiveDeviceItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding !IsActive}"
                                                    Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" FontSize="11" Padding="10,3" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Wireless Connect Panel -->
            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Connessione Wireless ADB" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="IP / Hostname:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding WirelessHost}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderLightBrush}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Porta:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding WirelessPort}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderLightBrush}"/>
                    </StackPanel>

                    <Button Content="Connetti Wireless" Command="{Binding ConnectWirelessCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="10"/>

                    <Separator Background="{DynamicResource BorderDarkBrush}"/>

                    <TextBlock Text="Accoppiamento Android 11+" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Codice di accoppiamento (6 cifre):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding PairingCode}" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderLightBrush}"/>
                    </StackPanel>

                    <Button Content="Accoppia Dispositivo" Command="{Binding PairWirelessCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                <Button Content="Verifica Dispositivo" Command="{Binding VerifyDeviceCommand}"
                        Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,10"/>
                <Button Content="Imposta come Dispositivo Attivo" Command="{Binding SaveSelectionCommand}"
                        Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="16,10"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
