<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="700"
        x:Class="IdleAutoGame.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Background="#181825">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Navigation Bar -->
        <Border Grid.Row="0" Background="#11111B" BorderBrush="#313244" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                    <TextBlock Text="IdleAutoGame" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Dashboard" Command="{Binding NavigateToDashboardCommand}"
                            Background="#181825" Foreground="#CDD6F4" Padding="14,6"/>
                    <Button Content="Devices" Command="{Binding NavigateToDevicesCommand}"
                            Background="#181825" Foreground="#CDD6F4" Padding="14,6"/>
                    <Button Content="AI Models" Command="{Binding NavigateToModelsCommand}"
                            Background="#181825" Foreground="#CDD6F4" Padding="14,6"/>
                    <Button Content="Games" Command="{Binding NavigateToGamesCommand}"
                            Background="#181825" Foreground="#CDD6F4" Padding="14,6"/>
                    <Button Content="Settings" Command="{Binding NavigateToSettingsCommand}"
                            Background="#181825" Foreground="#CDD6F4" Padding="14,6"/>
                </StackPanel>

                <!-- Status indicator -->
                <Border Grid.Column="2" Background="#181825" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="Linux Native" FontSize="11" Foreground="#A6E3A1"/>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Screen Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
