<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="700"
        x:Class="IdleAutoGame.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Navigation Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App Brand with Official Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="28" Height="28" VerticalAlignment="Center"/>
                    <TextBlock Text="IdleAutoGame" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Dashboard" Command="{Binding NavigateToDashboardCommand}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,6"/>
                    <Button Content="Devices" Command="{Binding NavigateToDevicesCommand}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,6"/>
                    <Button Content="AI Models" Command="{Binding NavigateToModelsCommand}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,6"/>
                    <Button Content="Games" Command="{Binding NavigateToGamesCommand}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,6"/>
                    <Button Content="Settings" Command="{Binding NavigateToSettingsCommand}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14,6"/>
                </StackPanel>

                <!-- Status indicator -->
                <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="Native Desktop" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Screen Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
