<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24" Background="#1E1E2E">
        <!-- Top Controls Bar -->
        <Border Grid.Row="0" Background="#2A2A3C" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Status Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="STATUS:" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                    <Border Background="#313244" CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding State}" FontWeight="Bold" Foreground="#89B4FA"/>
                    </Border>
                </StackPanel>

                <!-- Active Context Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveGameName, StringFormat='Game: {0}'}" Foreground="#CDD6F4"/>
                    <TextBlock Text="•" Foreground="#45475A"/>
                    <TextBlock Text="{Binding ActiveDeviceSerial, StringFormat='Device: {0}'}" Foreground="#CDD6F4"/>
                    <TextBlock Text="•" Foreground="#45475A"/>
                    <TextBlock Text="{Binding ActiveModelId, StringFormat='Model: {0}'}" Foreground="#CDD6F4"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="▶ Start" Command="{Binding StartAutomationCommand}" IsEnabled="{Binding CanStart}"
                            Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="16,8"/>
                    <Button Content="⏸ Pause" Command="{Binding PauseAutomationCommand}" IsEnabled="{Binding CanPause}"
                            Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" Padding="14,8"/>
                    <Button Content="⏯ Resume" Command="{Binding ResumeAutomationCommand}" IsEnabled="{Binding CanResume}"
                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="14,8"/>
                    <Button Content="⏹ STOP" Command="{Binding StopAutomationCommand}" IsEnabled="{Binding CanStop}"
                            Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Padding="18,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Dashboard Split -->
        <Grid Grid.Row="1" ColumnDefinitions="420,*">
            <!-- Left: Decisions & Overrides -->
            <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,16,0">
                <!-- Current Decision Card -->
                <Border Background="#2A2A3C" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <DockPanel>
                            <TextBlock Text="Latest AI Decision" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                            <Border DockPanel.Dock="Right" Background="#313244" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding LastActionConfidence, StringFormat='Confidence: {0:P0}'}" FontSize="11" Foreground="#A6E3A1"/>
                            </Border>
                        </DockPanel>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Action:" Foreground="#A6ADC8" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastActionType}" FontWeight="Bold" Foreground="#89B4FA"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Game State:" Foreground="#A6ADC8" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastGameState}" Foreground="#F9E2AF"/>
                        </Grid>

                        <TextBlock Text="Explanation:" FontSize="12" Foreground="#A6ADC8"/>
                        <Border Background="#181825" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding LastActionExplanation}" FontSize="13" Foreground="#CDD6F4" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- User Overrides Panel -->
                <Border Background="#2A2A3C" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Runtime User Instructions (Overrides)" FontSize="15" FontWeight="SemiBold" Foreground="#CDD6F4"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewOverrideText}" Watermark="e.g. Do not spend diamonds"
                                     Background="#181825" Foreground="#CDD6F4" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Send" Command="{Binding AddOverrideCommand}"
                                    Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="12,6"/>
                        </Grid>

                        <TextBlock Text="Active Overrides:" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding ActiveOverrides}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#181825" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Text}" FontSize="12" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕ Revoke" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).RemoveOverrideCommand}"
                                                    CommandParameter="{Binding}" Background="#313244" Foreground="#F38BA8" Padding="6,2" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: Metrics and History -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Metrics Strip -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,16">
                    <Border Grid.Column="0" Background="#2A2A3C" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CYCLES" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock Text="{Binding CyclesCount}" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#2A2A3C" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ACTIONS" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock Text="{Binding ActionsCount}" FontSize="22" FontWeight="Bold" Foreground="#A6E3A1"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#2A2A3C" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ERRORS" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock Text="{Binding ErrorsCount}" FontSize="22" FontWeight="Bold" Foreground="#F38BA8"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#2A2A3C" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LATENCY" FontSize="11" Foreground="#A6ADC8"/>
                            <TextBlock Text="{Binding LastLatencyMs, StringFormat='{}{0} ms'}" FontSize="22" FontWeight="Bold" Foreground="#CBA6F7"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Cycle History Table -->
                <Border Grid.Row="1" Background="#2A2A3C" CornerRadius="8" Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Telemetry &amp; Cycle Log" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4" Margin="0,0,0,12"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding RecentCycles}" Background="#181825" CornerRadius="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#313244">
                                        <Grid ColumnDefinitions="60,80,120,*,80">
                                            <TextBlock Grid.Column="0" Text="{Binding CycleNumber, StringFormat='#{0}'}" FontWeight="Bold" Foreground="#89B4FA"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Action.Action}" Foreground="#CDD6F4"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Action.GameState}" Foreground="#F9E2AF"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Action.Explanation}" Foreground="#A6ADC8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LlmLatencyMs, StringFormat='{}{0} ms'}" Foreground="#6C7086" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
