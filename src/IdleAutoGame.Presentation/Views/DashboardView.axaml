<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IdleAutoGame.Presentation.ViewModels"
             x:Class="IdleAutoGame.Presentation.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <!-- Row 0: Top Controls Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="▶ Avvia" Command="{Binding StartAutomationCommand}" IsEnabled="{Binding CanStart}"
                            Background="{DynamicResource PrimaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="14,8"/>
                    <Button Content="⏸ Pausa" Command="{Binding PauseAutomationCommand}" IsEnabled="{Binding CanPause}"
                            Background="{DynamicResource WarningBrush}" Foreground="#091015" FontWeight="Bold" Padding="12,8"/>
                    <Button Content="⏯ Riprendi" Command="{Binding ResumeAutomationCommand}" IsEnabled="{Binding CanResume}"
                            Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="12,8"/>
                    <Button Content="⏹ Arresta" Command="{Binding StopAutomationCommand}" IsEnabled="{Binding CanStop}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontWeight="Bold" Padding="12,8"/>
                    <Button Content="🚨 EMERGENZA" Command="{Binding EmergencyStopAutomationCommand}" IsEnabled="{Binding CanEmergencyStop}"
                            Background="{DynamicResource ErrorBrush}" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="STATO AGENTE:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding AgentStateText}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Border Background="#332B00" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" IsVisible="{Binding IsLlmWarmingUp}">
                            <TextBlock Text="🔥 WARMUP IN CORSO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Policy Spesa:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding PremiumCurrencyStatusText, StringFormat='Currency: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding CreditPurchasesStatusText, StringFormat='Crediti: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: ACTIVE CONTEXT HUB (Authoritative Central Information) -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Title Strip with Refresh -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="🔄 Verifica Foreground Device" Command="{Binding RefreshForegroundCommand}"
                            Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="10,4" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="⚡ STATO ATTIVO &amp; CONTESTO OPERATIVO" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="(Autoritativo e sincronizzato in tempo reale)" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- 4 Core Context Cards -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*">
                    <!-- 1. Modello LLM -->
                    <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock Text="🧠 MODELLO LLM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Surface1Brush}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="{Binding LlmPhaseText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveModelName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <DockPanel>
                                <TextBlock Text="{Binding ActiveModelProvider, StringFormat='Provider: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryLightBrush}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LlmStatusDetail}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" TextTrimming="CharacterEllipsis" MaxWidth="120" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Telefono Android -->
                    <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock Text="📱 TELEFONO ANDROID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Surface1Brush}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="{Binding ActiveDeviceStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveDeviceDisplayName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ActiveDeviceSerial, StringFormat='Seriale: {0}'}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Text="{Binding ActiveDeviceConnectionType}" FontSize="11" Foreground="{DynamicResource PrimaryLightBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Gioco Attivo -->
                    <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock Text="🎮 GIOCO ATTIVO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Surface1Brush}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="{Binding ActiveGamePackage}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveGameName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ActiveGameDetectionStatus}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Activity Guard -->
                    <Border Grid.Column="3" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock Text="🛡️ ACTIVITY GUARD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Surface1Brush}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="{Binding GuardStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding GuardDetailText}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Fail-safe attivo: gesti bloccati se fuori gioco" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 2: Pipeline Step Tracker (Active Cycle Progress) -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Border.Styles>
                <Style Selector="Border.step-card">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
                <Style Selector="Border.step-card.active">
                    <Setter Property="Background" Value="#1A3333"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Style>
            </Border.Styles>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="PIPELINE ATTIVA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding LlmStatusDetail}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*,Auto,*">
                    <!-- Step 1: Screenshot -->
                    <Border Grid.Column="0" Classes="step-card" Classes.active="{Binding IsStep1Active}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="📸 1. Screenshot" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cattura frame ADB" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="➔" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="6,0"/>

                    <!-- Step 2: LLM Inference / Warmup -->
                    <Border Grid.Column="2" Classes="step-card" Classes.active="{Binding IsStep2Active}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="🧠 2. Analisi LLM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LlmPhaseText}" FontSize="9" Foreground="{DynamicResource SecondaryLightBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="3" Text="➔" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="6,0"/>

                    <!-- Step 3: Validazione Policy -->
                    <Border Grid.Column="4" Classes="step-card" Classes.active="{Binding IsStep3Active}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="🛡️ 3. Validazione" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Security &amp; Bounds" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="5" Text="➔" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="6,0"/>

                    <!-- Step 4: Esecuzione ADB -->
                    <Border Grid.Column="6" Classes="step-card" Classes.active="{Binding IsStep4Active}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="👆 4. Esecuzione" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Gesture Touch ADB" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="7" Text="➔" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="6,0"/>

                    <!-- Step 5: Cooldown -->
                    <Border Grid.Column="8" Classes="step-card" Classes.active="{Binding IsStep5Active}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="⏱️ 5. Cooldown" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pausa intervallo" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Row 3: Alert / Pause Reason Banner -->
        <Border Grid.Row="3" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,16" IsVisible="{Binding IsPausedOrAlert}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="AUTOMAZIONE IN PAUSA / SEGNALAZIONE AGENTE" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding AgentDetailText, StringFormat='Dettaglio: {0}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Main Dashboard Split -->
        <Grid Grid.Row="4" ColumnDefinitions="420,*">
            <!-- Left: Decisions & Overrides -->
            <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,16,0">
                <!-- Current Decision Card -->
                <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <DockPanel>
                            <TextBlock Text="Ultima Decisione AI" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding LastActionConfidence, StringFormat='Confidenza: {0:P0}'}" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                        </DockPanel>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Azione:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastActionType}" FontWeight="Bold" Foreground="{DynamicResource SecondaryLightBrush}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Stato Gioco:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastGameState}" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>

                        <TextBlock Text="Spiegazione LLM:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding LastActionExplanation}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <Button Content="🔍 Diagnostica Decisione AI (Dettagli)" Command="{Binding OpenAiDecisionDetailsCommand}"
                                Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                FontWeight="Bold" Padding="10,8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Runtime Security Policy Card -->
                <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <TextBlock Text="Politica di Sicurezza Runtime" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding PremiumCurrencyStatusText, StringFormat='Premium: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding CreditPurchasesStatusText, StringFormat='Crediti: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <CheckBox IsChecked="{Binding AllowPremiumCurrency}" Content="Permetti all'LLM di usare currency premium"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        <CheckBox IsChecked="{Binding AllowCreditPurchases}" Content="Permetti all'LLM di acquistare crediti"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- User Overrides Panel -->
                <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Istruzioni Utente Runtime (Overrides)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewOverrideText}" Watermark="es. Non toccare la fata"
                                     Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Invia" Command="{Binding AddOverrideCommand}"
                                    Background="{DynamicResource SecondaryMainBrush}" Foreground="#091015" FontWeight="Bold" Padding="12,6"/>
                        </Grid>

                        <TextBlock Text="Overrides Attivi:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding ActiveOverrides}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕ Revoca" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).RemoveOverrideCommand}"
                                                    CommandParameter="{Binding}" Background="{DynamicResource Surface1Brush}" Foreground="{DynamicResource ErrorBrush}"
                                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="6,2" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: Metrics and History -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Metrics Strip -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,16">
                    <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CICLI" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CyclesCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="AZIONI" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ActionsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ERRORI" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ErrorsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LATENZA" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastLatencyMs, StringFormat='{}{0} ms'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SecondaryLightBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Cycle History Table -->
                <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Registro Telemetria &amp; Cicli di Gioco" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding RecentCycles}" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDarkBrush}">
                                        <Grid ColumnDefinitions="45,110,80,100,*,75">
                                            <TextBlock Grid.Column="0" Text="{Binding CycleNumber, StringFormat='#{0}'}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}" BorderThickness="1" BorderBrush="{DynamicResource BorderLightBrush}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Action.Action}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Action.GameState}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Action.Explanation}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding LlmLatencyMs, StringFormat='{}{0} ms'}" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
